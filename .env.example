# ---------------------------------------------------------------------------
# LOCAL development template. Copy to `.env`:
#   cp .env.example .env
#
# For PRODUCTION / Coolify values, see .env.production.example.
# ---------------------------------------------------------------------------

# PostgreSQL — points at the docker-compose `db` service (mapped to localhost).
DATABASE_URL="postgresql://trendscore:trendscorepass@127.0.0.1:5432/trendscore?schema=public"

# Redis — points at the docker-compose `redis` service.
REDIS_URL="redis://127.0.0.1:6379"

# Maintenance / Coming Soon gate: "true" or "false".
#   true  -> Coming Soon page everywhere
#   false -> landing/demo page + app (auth, dashboard)
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"

# Public app URL (used by the Freemius SDK for checkout/portal callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Freemius ---
FREEMIUS_PRODUCT_ID=""
NEXT_PUBLIC_FREEMIUS_STORE_ID=""
FREEMIUS_PUBLIC_KEY=""
FREEMIUS_SECRET_KEY=""
FREEMIUS_API_KEY=""
# Pro plan's pricing id (gates Pro access).
NEXT_PUBLIC_FREEMIUS_PRO_PRICING_ID="85687"

# --- OAuth (optional — buttons appear only when both keys of a provider are set) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- docker-compose local DB credentials (used by docker-compose.yml) ---
POSTGRES_DB=trendscore
POSTGRES_USER=trendscore
POSTGRES_PASSWORD=trendscorepass
