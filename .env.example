# ---------------------------------------------------------------------------
# LOCAL development template. Copy to `.env`:
#   cp .env.example .env
#
# For PRODUCTION / Coolify values, see .env.production.example.
# ---------------------------------------------------------------------------

# PostgreSQL — points at the docker-compose `db` service (mapped to localhost).
DATABASE_URL="postgresql://trendscore:trendscorepass@127.0.0.1:5432/trendscore?schema=public"

# Redis — points at the docker-compose `redis` service.
REDIS_URL="redis://127.0.0.1:6379"

# Maintenance / Coming Soon gate: "true" or "false".
#   true  -> Coming Soon page everywhere
#   false -> landing/demo page + app (auth, dashboard)
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"

# Public app URL (used by the Freemius SDK for checkout/portal callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Client WebSocket Gateway (Phase 4) ---
# Browser URL for the standalone WS gateway. NEXT_PUBLIC_* is inlined into the
# client bundle at BUILD time, so set it before building the web image.
#   Local:      ws://localhost:3001
#   Production: wss://trendscore.io/ws   (route port 3001 via your reverse proxy)
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
# Port the gateway process listens on (server-side).
WS_GATEWAY_PORT="3001"

# --- Freemius ---
FREEMIUS_PRODUCT_ID=""
NEXT_PUBLIC_FREEMIUS_STORE_ID=""
FREEMIUS_PUBLIC_KEY=""
FREEMIUS_SECRET_KEY=""
FREEMIUS_API_KEY=""
# Pro plan's pricing id (gates Pro access).
NEXT_PUBLIC_FREEMIUS_PRO_PRICING_ID="85687"
# Ultimate plan's pricing id (gates Ultimate access).
NEXT_PUBLIC_FREEMIUS_ULTIMATE_PRICING_ID="88832"
# Sandbox (test) checkout. "true" = fake payments (test card 4242...),
# "false" = live payments. Defaults to sandbox locally.
FREEMIUS_SANDBOX="true"

# --- OAuth (optional — buttons appear only when both keys of a provider are set) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- docker-compose local DB credentials (used by docker-compose.yml) ---
POSTGRES_DB=trendscore
POSTGRES_USER=trendscore
POSTGRES_PASSWORD=trendscorepass

# --- Binance Futures market ingestion worker ---
# Public market data (klines/tickers) works without keys. Keys raise rate
# limits and are required only if you later add authenticated endpoints.
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
# "true" routes REST + WS to the Binance Futures testnet.
BINANCE_USE_TESTNET="false"
# --- Symbol universe (dynamic discovery) ---
# By DEFAULT the worker discovers its tradable universe live from Binance every
# scan: all USDT-M perps, filtered to genuine crypto (excludes stablecoins,
# stock/index/commodity perps), then qualified by the thresholds below and
# sorted by 24h volume. BTC/ETH are always included for regime context.
#
# Set SYMBOL_DISCOVERY="false" to disable discovery and use the static default
# list, OR pin TRACKED_SYMBOLS to lock the worker to an explicit set (this also
# disables discovery). Leave TRACKED_SYMBOLS empty to use discovery.
SYMBOL_DISCOVERY="true"
TRACKED_SYMBOLS=""
# Cap on how many discovered symbols to stream (WS stream budget).
MAX_TRACKED_SYMBOLS="60"
# Universe qualification thresholds (mirror the trade engine's defaults).
MIN_24H_VOLUME_USDT="10000000"
MAX_24H_CHANGE_PCT="35"
MIN_FUNDING_RATE="-0.0001"
MAX_FUNDING_RATE="0.00015"

# --- AI analysis engine (Phase 3) ---
# LLM used to generate structured trade analyses (Google AI Studio / Gemini).
# If AI_API_KEY is unset the engine degrades to a deterministic, rule-based
# summary (no network calls) so the worker never crashes.
# Legacy GEMINI_API_KEY / GEMINI_MODEL are honored as fallbacks.
AI_API_KEY=""
# AI_MODELS: ordered, comma-separated price-performance fallback chain. The
# engine tries each in order and uses the first that responds, only paying for
# a pricier model when the cheaper one is unavailable / rate-limited. If unset,
# a single AI_MODEL (or the built-in default chain) is used.
AI_MODELS="gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-flash"
AI_MODEL="gemini-2.0-flash"
