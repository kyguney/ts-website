# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development (outside Docker):
#   cp .env.example .env
# ---------------------------------------------------------------------------

# MySQL connection string used by Prisma.
#
# Local (running `npm run dev` against the docker-compose MySQL):
# MySQL 8.4 enables TLS with a self-signed cert by default, which makes Prisma
# fail with "P1017: Server has closed the connection". `sslaccept=accept_invalid_certs`
# tells Prisma to accept it — fine for a local DB. Use 127.0.0.1 (not localhost)
# to force TCP.
DATABASE_URL="mysql://trendscore:trendscorepass@127.0.0.1:3306/trendscore?sslaccept=accept_invalid_certs"
#
# On Coolify: set DATABASE_URL in the app's Environment Variables to the
# managed MySQL connection string, e.g.
#   mysql://<user>:<password>@<mysql-service-host>:3306/<database>
# Use the INTERNAL host Coolify shows for the database service.

# --- docker-compose local DB credentials (used by docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=trendscore
MYSQL_USER=trendscore
MYSQL_PASSWORD=trendscorepass
