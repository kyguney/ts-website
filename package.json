{
  "name": "trendscore-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker": "tsx src/workers/market-worker.ts",
    "ws-gateway": "tsx src/workers/ws-gateway.ts",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "test:engine": "tsx scripts/test-engine.ts",
    "test:ai": "tsx scripts/test-ai-analysis.ts",
    "postinstall": "prisma generate",
    "docker:up": "docker compose up --build -d",
    "docker:up:logs": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:fresh": "docker compose build --no-cache && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose down && docker compose up --build -d"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@freemius/checkout": "^1.5.0",
    "@freemius/sdk": "^0.5.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "0.6.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "dotenv": "16.6.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "prisma": "^6.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "ws": "8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6"
  }
}
