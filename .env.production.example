# =============================================================================
# PRODUCTION environment template (Coolify)
#
# Copy the relevant values into your Coolify Application → Environment Variables.
# Do NOT commit real secrets. This file documents what must be configured.
# Generate secrets with:  openssl rand -base64 32
# =============================================================================

# ---- Core ----
NODE_ENV="production"

# Maintenance / Coming Soon gate. Read at runtime by middleware, so you can flip
# it in the Coolify UI and RESTART the container to apply — no rebuild needed.
#   "true"  -> everything shows the Coming Soon page
#   "false" -> landing/demo page + full app (auth, dashboard, billing)
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# ---- Auth (NextAuth / Auth.js) ----
# Public URL of the app on Coolify (must match the domain, incl. https://).
NEXTAUTH_URL="https://trendscore.io"
# Random 32+ byte secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public app URL — used by the Freemius SDK for checkout/portal callbacks.
# Should match your production domain.
NEXT_PUBLIC_APP_URL="https://trendscore.io"

# ---- Database (PostgreSQL) ----
# Option A (Coolify managed Postgres): use the INTERNAL hostname Coolify shows
# for the database service (commonly the service name), e.g. "postgres".
# Option B (docker-compose.prod.yml): the host is the compose service "db".
DATABASE_URL="postgresql://<user>:<password>@postgres:5432/<database>?schema=public"

# ---- Cache (Redis) ----
# Option A: internal hostname of the managed Redis service, e.g. "redis".
# Option B: the compose service "redis".
REDIS_URL="redis://redis:6379"

# ---- Freemius (billing / licensing) ----
# From the Freemius Developer Dashboard → your product → Settings → Keys.
FREEMIUS_PRODUCT_ID=""
NEXT_PUBLIC_FREEMIUS_STORE_ID=""
FREEMIUS_PUBLIC_KEY=""       # pk_...
FREEMIUS_SECRET_KEY=""       # sk_...  (also used to verify webhook signatures)
FREEMIUS_API_KEY=""
# Pro plan pricing id (gates Pro access). Freemius: Plans → Pro → pricing id.
NEXT_PUBLIC_FREEMIUS_PRO_PRICING_ID="85687"
# Sandbox (test) checkout switch. Set "true" to test with fake cards on the
# live deploy, then set "false" (or remove) for real launch.
FREEMIUS_SANDBOX="true"
# NOTE: The Freemius JS SDK authenticates incoming webhooks with FREEMIUS_SECRET_KEY
# (HMAC signature). There is no separate webhook secret to configure.

# ---- OAuth (optional) ----
# Buttons render only when BOTH keys of a provider are set. Leave blank to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ---- docker-compose.prod.yml only (Option B) ----
# These provision the bundled Postgres container and are interpolated into
# DATABASE_URL above. Not needed when using Coolify managed Postgres.
POSTGRES_DB="trendscore"
POSTGRES_USER="trendscore"
POSTGRES_PASSWORD="replace-with-a-strong-password"
